                <span class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Target Muscle</span>
                <select
                  [ngModel]="quickAddForm().primaryMuscle"
                  (ngModelChange)="updateQuickAddField('primaryMuscle', $event)"
