<file path="app/shared/kpi-card/kpi-card.component.html">
<div
  class="p-6 rounded-[1.5rem] border transition-all hover:shadow-md flex flex-col h-full group overflow-visible"
  [ngStyle]="containerStyles()"
  [class.cursor-pointer]="actionType() !== 'none'"
  (click)="handleClick()"
>
  <!-- Header: Label and Icons (always visible) -->
  <div class="flex items-center justify-between">
    <!-- Label -->
    <span
      class="text-[10px] font-black uppercase tracking-widest mt-1"
      [ngClass]="labelClass() || themeStyles().labelText"
    >
      {{ label() }}
    </span>

    <!-- Icons Container -->
    <div class="flex items-center gap-2">
      <!-- Main Icon -->
      <div
        class="p-2.5 transition-colors rounded-[14px]"
        [ngClass]="[themeStyles().iconBg, themeStyles().iconHover, themeStyles().iconText]"
      >
        <lucide-icon [name]="mainIcon()" class="w-5 h-5"></lucide-icon>
      </div>

      <!-- Info Icon & Popover (Conditional) -->
      @if (showInfoIcon()) {
        <div class="relative group/info">
          <div
            class="w-10 h-10 flex items-center justify-center rounded-[14px] transition-all cursor-help"
            (mouseenter)="checkMenuPosition($event)"
            [ngStyle]="{ 'background-color': themeStyles().iconBg, color: themeStyles().labelText }"
          >
            <lucide-icon name="info" class="w-5 h-5"></lucide-icon>
          </div>

          <div
            class="absolute top-full mt-3 w-72 p-4 bg-slate-900 rounded-2xl shadow-2xl z-50 opacity-0 group-hover/info:opacity-100 invisible group-hover/info:visible transition-all duration-200 ease-out scale-95 group-hover/info:scale-100"
            [class.left-1]="menuPosition() === 'left-aligned'"
            [class.origin-top-left]="menuPosition() === 'left-aligned'"
            [class.right-1]="menuPosition() === 'right-aligned'"
            [class.origin-top-right]="menuPosition() === 'right-aligned'"
            [class.left-1/2]="menuPosition() === 'centered'"
            [class.-translate-x-1/2]="menuPosition() === 'centered'"
            [class.origin-top]="menuPosition() === 'centered'"
          >
            <p class="text-[12px] leading-relaxed font-medium text-white">{{ infoText() }}</p>
          </div>
        </div>
      }
    </div>
  </div>

  <!-- Default Content (Value, Trend, Context) -->
  @if (!useCustomContent()) {
    <!-- Value -->
    <h3
      class="text-[32px] font-black mt-2 tracking-tight"
      [ngClass]="valueClass() || themeStyles().valueText"
    >
      {{ value() }}
    </h3>

    <!-- Footer: Trend and Context -->
    <div class="flex items-center justify-between mt-4">
      <!-- Trend -->
      <span
        class="text-xs font-bold"
        [class.text-emerald-600]="trend().startsWith('+')"
        [class.text-rose-600]="trend().startsWith('-')"
      >
        {{ trend() }}
      </span>

      <!-- Context -->
      <span class="text-[11px] font-medium" [ngClass]="themeStyles().contextText">
        {{ context() }}
      </span>
    </div>
  }

  <!-- Custom Content Slot -->
  @if (useCustomContent()) {
    <div class="flex-1 min-h-0 mt-2 animate-fade-in">
      <ng-content></ng-content>
    </div>
  }
</div>
