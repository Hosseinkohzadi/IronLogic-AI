<file path="app/features/athlete/athlete-portal.html">
<div class="min-h-screen bg-slate-50 p-4 sm:p-6 lg:p-8">
  @if (!hasAccessToAthletePortal()) {
    <div class="mx-auto max-w-3xl rounded-3xl border border-rose-200 bg-white p-8 text-center shadow-sm">
      <h1 class="text-2xl font-black text-slate-900">Portal Access Required</h1>
      <p class="mt-2 text-sm text-slate-500">
        Your current session is not authorized for the athlete portal. Please login as an athlete.
      </p>
      <button
        type="button"
        class="mt-6 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-bold text-white hover:bg-indigo-700"
        (click)="goToLogin()"
      >
        Back to Login
      </button>
    </div>
  } @else {
    <div class="mx-auto max-w-[1440px]">
      @if (!isWorkingOut()) {
        <section class="grid grid-cols-1 gap-8 xl:grid-cols-12">
          <div class="xl:col-span-8 space-y-8">
            <header>
              <h1 class="text-3xl font-black text-slate-900">
                Welcome back, {{ currentAthleteData()?.athleteName }}! ⚡
              </h1>
              <p class="mt-2 text-sm font-medium text-slate-500">
                Your next session is loaded and ready. Stay focused and execute with precision.
              </p>
            </header>

            <article class="rounded-3xl border border-indigo-100 bg-white p-6 shadow-sm">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <p class="text-xs font-black uppercase tracking-[0.14em] text-indigo-600">Active Routine</p>
                  <h2 class="mt-1 text-2xl font-black text-slate-900">
                    {{ currentAthleteData()?.activeRoutineTitle }}
                  </h2>
                </div>
                <button
                  type="button"
                  class="rounded-2xl bg-indigo-600 px-8 py-4 text-sm font-black uppercase tracking-[0.12em] text-white shadow-lg shadow-indigo-600/30 hover:bg-indigo-700"
                  (click)="startWorkout()"
                >
                  Start Workout
                </button>
              </div>

              <div class="mt-6 space-y-3">
                @for (exercise of currentAthleteData()?.routinePreview ?? []; track exercise.name) {
                  <div class="flex items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
                    <p class="text-sm font-bold text-slate-800">{{ exercise.name }}</p>
                    <span
                      class="rounded-full bg-indigo-100 px-3 py-1 text-[11px] font-bold text-indigo-700"
                    >
                      ✨ AI Suggestion: {{ exercise.suggestion }}
                    </span>
                  </div>
                }
              </div>
            </article>

            <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-sm font-black uppercase tracking-[0.12em] text-slate-700">
                  Tonnage / 1RM Trend
                </h3>
                <p class="text-xs font-semibold text-slate-400">Last 7 sessions</p>
              </div>

              <div class="mt-4 rounded-2xl border border-slate-100 bg-slate-50 p-4">
                <svg viewBox="0 0 560 220" class="h-64 w-full" role="img" aria-label="Progress line chart">
                  <polyline
                    points="{{ lineChartPoints() }}"
                    fill="none"
                    stroke="#4f46e5"
                    stroke-width="4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></polyline>
                </svg>
              </div>
            </article>
          </div>

          <div class="xl:col-span-4 space-y-8">
            <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
              <h3 class="text-sm font-black uppercase tracking-[0.12em] text-slate-700">Coach's Corner</h3>
              <p class="mt-3 text-sm leading-6 text-slate-600">
                {{ currentAthleteData()?.coachCorner?.message }}
              </p>
              <p class="mt-4 text-xs font-bold text-indigo-600">
                {{ currentAthleteData()?.coachCorner?.coachName }}
              </p>
              <button
                type="button"
                class="mt-5 w-full rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm font-bold text-indigo-700 hover:bg-indigo-100"
              >
                Upload Form Video
              </button>
            </article>

            <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
              <h3 class="text-sm font-black uppercase tracking-[0.12em] text-slate-700">
                Targeted Muscles This Week
              </h3>
              <div class="mt-4 space-y-3">
                @for (muscle of currentAthleteData()?.muscleHeatmap ?? []; track muscle.muscle) {
                  <div>
                    <div class="mb-1 flex items-center justify-between text-xs font-bold text-slate-600">
                      <span>{{ muscle.muscle }}</span>
                      <span>{{ muscle.intensity }}%</span>
                    </div>
                    <div class="h-2 rounded-full bg-slate-100">
                      <div
                        class="h-2 rounded-full bg-indigo-600"
                        [style.width.%]="muscle.intensity"
                      ></div>
                    </div>
                  </div>
                }
              </div>
            </article>

            <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
              <h3 class="text-sm font-black uppercase tracking-[0.12em] text-slate-700">Consistency Calendar</h3>
              <div class="mt-4 grid grid-cols-7 gap-2">
                @for (day of currentAthleteData()?.calendarDays ?? []; track day.day) {
                  <div
                    class="h-9 rounded-lg border text-xs font-bold flex items-center justify-center"
                    [class.border-indigo-200]="day.completed"
                    [class.bg-indigo-50]="day.completed"
                    [class.text-indigo-700]="day.completed"
                    [class.border-slate-200]="!day.completed"
                    [class.bg-white]="!day.completed"
                    [class.text-slate-500]="!day.completed"
                  >
                    @if (day.completed) {
                      ✓
                    } @else {
                      {{ day.day }}
                    }
                  </div>
                }
              </div>
            </article>
          </div>
        </section>
      } @else {
        <section class="space-y-6">
          <header class="sticky top-0 z-10 rounded-3xl border border-slate-200 bg-white/95 p-5 shadow-sm backdrop-blur">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div>
                <p class="text-xs font-black uppercase tracking-[0.14em] text-indigo-600">Live Workout Logger</p>
                <h1 class="text-2xl font-black text-slate-900">Leg Day</h1>
              </div>

              <div class="flex items-center gap-3">
                <div class="rounded-xl border border-slate-200 px-4 py-2">
                  <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Elapsed</p>
                  <p class="text-lg font-black text-slate-900">{{ formatSeconds(elapsedSeconds()) }}</p>
                </div>
                <div class="rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-2">
                  <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-indigo-500">Global Rest</p>
                  <p class="text-lg font-black text-indigo-700">{{ formatSeconds(restRemainingSeconds()) }}</p>
                </div>
                <button
                  type="button"
                  class="rounded-xl border border-slate-300 px-4 py-3 text-xs font-bold uppercase tracking-[0.12em] text-slate-700 hover:bg-slate-50"
                  (click)="stopWorkout()"
                >
                  End Session
                </button>
              </div>
            </div>
          </header>

          <div class="space-y-5">
            @for (exercise of workoutExercises(); track exercise.id) {
              <article class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="mb-4 flex items-center justify-between gap-3">
                  <h2 class="text-lg font-black text-slate-900">{{ exercise.name }}</h2>
                  <button
                    type="button"
                    class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-indigo-200 bg-indigo-50 text-sm font-black text-indigo-700"
                    aria-label="Open exercise insights"
                    (click)="openExerciseInsights(exercise.id)"
                  >
                    i
                  </button>
                </div>

                <div class="overflow-x-auto">
                  <table class="min-w-full text-sm">
                    <thead>
                      <tr class="border-b border-slate-200 text-left text-xs uppercase tracking-[0.12em] text-slate-500">
                        <th class="px-3 py-3">Set #</th>
                        <th class="px-3 py-3">Previous (kg x reps)</th>
                        <th class="px-3 py-3">Target</th>
                        <th class="px-3 py-3">Actual Inputs</th>
                        <th class="px-3 py-3">Done</th>
                      </tr>
                    </thead>
                    <tbody>
                      @for (set of exercise.sets; track set.id) {
                        <tr class="border-b border-slate-100">
                          <td class="px-3 py-3 font-bold text-slate-700">{{ set.id }}</td>
                          <td class="px-3 py-3 text-slate-600">{{ set.previous }}</td>
                          <td class="px-3 py-3 font-semibold text-slate-700">{{ set.target }}</td>
                          <td class="px-3 py-3">
                            <div class="flex items-center gap-2">
                              <input
                                type="number"
                                inputmode="numeric"
                                class="w-24 rounded-xl border border-slate-200 px-3 py-2 text-sm font-bold outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 disabled:bg-slate-100"
                                placeholder="kg"
                                [disabled]="set.done"
                                [ngModel]="set.actualKg"
                                (ngModelChange)="updateActualKg(exercise.id, set.id, $event)"
                              />
                              <input
                                type="number"
                                inputmode="numeric"
                                class="w-24 rounded-xl border border-slate-200 px-3 py-2 text-sm font-bold outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 disabled:bg-slate-100"
                                placeholder="reps"
                                [disabled]="set.done"
                                [ngModel]="set.actualReps"
                                (ngModelChange)="updateActualReps(exercise.id, set.id, $event)"
                              />
                            </div>
                          </td>
                          <td class="px-3 py-3">
                            <button
                              type="button"
                              class="rounded-xl px-4 py-2 text-xs font-bold uppercase tracking-[0.1em]"
                              [class.bg-emerald-600]="set.done"
                              [class.text-white]="set.done"
                              [class.bg-indigo-600]="!set.done"
                              [class.text-white]="!set.done"
                              [disabled]="set.done"
                              (click)="markSetDone(exercise.id, set.id)"
                            >
                              {{ set.done ? 'Done' : 'Mark Done' }}
                            </button>
                          </td>
                        </tr>
                      }
                    </tbody>
                  </table>
                </div>
              </article>
            }
          </div>
        </section>
      }
    </div>

    @if (selectedExercise()) {
      <div class="fixed inset-0 z-40 bg-slate-900/40" (click)="closeExerciseInsights()" aria-hidden="true"></div>
      <aside
        class="fixed inset-x-4 top-1/2 z-50 mx-auto w-full max-w-2xl -translate-y-1/2 rounded-3xl border border-slate-200 bg-white p-6 shadow-2xl"
        role="dialog"
        aria-modal="true"
        aria-label="Exercise insights"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.14em] text-indigo-600">Smart Insights</p>
            <h2 class="mt-1 text-2xl font-black text-slate-900">{{ selectedExercise()?.name }}</h2>
          </div>
          <button
            type="button"
            class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100"
            (click)="closeExerciseInsights()"
            aria-label="Close insights"
          >
            ×
          </button>
        </div>

        <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
          <section class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <h3 class="text-sm font-black uppercase tracking-[0.1em] text-slate-700">1RM History</h3>
            <ul class="mt-3 space-y-2 text-sm text-slate-600">
              @for (oneRm of selectedExercise()?.oneRmHistory ?? []; track oneRm) {
                <li class="rounded-lg bg-white px-3 py-2 font-semibold">{{ oneRm }}</li>
              }
            </ul>
          </section>

          <section class="rounded-2xl border border-indigo-100 bg-indigo-50 p-4">
            <h3 class="text-sm font-black uppercase tracking-[0.1em] text-indigo-700">Coach Notes</h3>
            <p class="mt-3 text-sm leading-6 text-indigo-900">{{ selectedExercise()?.coachNotes }}</p>
          </section>
        </div>
      </aside>
    }
  }
</div>
