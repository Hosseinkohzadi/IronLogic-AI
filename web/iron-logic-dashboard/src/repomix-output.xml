            </div>
          </div>

          <div class="rounded-2xl border border-slate-100/50 bg-white p-5 shadow-sm">
            <h3 class="mb-3.5 text-sm font-black text-slate-900">Actions</h3>
            <div class="flex flex-col gap-2">
              <button
                type="button"
                class="w-full px-4 py-2.5 bg-black text-white text-[11px] font-bold rounded-xl hover:bg-slate-800 transition-all"
                (click)="handleEdit(selectedMuscleDetails()?.id || '')">
                Edit
              </button>
              <button
                type="button"
                class="w-full px-4 py-2.5 bg-slate-100 text-slate-700 text-[11px] font-bold rounded-xl hover:bg-slate-200 transition-all"
                (click)="handleMerge(selectedMuscleDetails()?.id || '')">
                Merge
              </button>
              <button
                type="button"
                class="w-full px-4 py-2.5 bg-slate-100 text-slate-700 text-[11px] font-bold rounded-xl hover:bg-slate-200 transition-all"
                (click)="handleDelete(selectedMuscleDetails()?.id || '')">
                Delete
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  }

  @if (isAddModalOpen()) {
    <div class="fixed inset-0 z-50 bg-slate-900/50 flex items-center justify-center p-4 animate-in">
      <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 animate-in">
        <h2 class="text-2xl font-black text-slate-900 mb-6">Add New Muscle</h2>

        <div class="space-y-4 mb-6">
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase mb-2 tracking-wide">Muscle Name</label>
            <input
              type="text"
              placeholder="e.g., Chest"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-900 placeholder-slate-400 focus:outline-none focus:border-black focus:ring-2 focus:ring-black focus:ring-opacity-10 transition-all"
              [(ngModel)]="newMuscleName">
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase mb-2 tracking-wide">Scientific Name</label>
            <input
              type="text"
              placeholder="e.g., Pectoralis Major"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-900 placeholder-slate-400 focus:outline-none focus:border-black focus:ring-2 focus:ring-black focus:ring-opacity-10 transition-all"
              [(ngModel)]="newMuscleScientific">
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase mb-2 tracking-wide">Region</label>
            <select
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-900 focus:outline-none focus:border-black focus:ring-2 focus:ring-black focus:ring-opacity-10 transition-all"
              [(ngModel)]="newMuscleRegion">
              <option value="Upper Body">Upper Body</option>
              <option value="Lower Body">Lower Body</option>
              <option value="Core">Core</option>
              <option value="Full Body">Full Body</option>
            </select>
          </div>
        </div>

        <div class="flex gap-3">
          <button
            type="button"
            class="flex-1 px-4 py-2.5 bg-slate-100 text-slate-700 text-sm font-bold rounded-xl hover:bg-slate-200 transition-all"
            (click)="closeAddModal()">
            Cancel
          </button>
          <button
            type="button"
            class="flex-1 px-4 py-2.5 bg-black text-white text-sm font-bold rounded-xl hover:bg-slate-800 transition-all"
            (click)="saveNewMuscle()">
            Save
          </button>
        </div>
      </div>
    </div>
  }
</div>

<div *ngIf="isEditModalOpen()" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[60] flex justify-center items-center p-4">
  <div class="bg-white rounded-[2rem] w-full max-w-lg shadow-2xl overflow-hidden flex flex-col">
