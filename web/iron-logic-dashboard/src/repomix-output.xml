<file path="app/shared/ui/metric-card/metric-card.component.css">
:host {
  display: block;
}

.metric-card {
  border-radius: 1.5rem;
  background-color: #fff;
  padding: 2rem;
  box-shadow: 0 2px 10px -3px rgba(6,81,237,0.05);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
  border: 1px solid #f8fafc;
}

.metric-card-title {
  font-size: 0.75rem; /* text-xs */
  font-weight: bold; /* font-bold */
  letter-spacing: 0.1em; /* tracking-widest */
  color: #94a3b8; /* text-slate-400 */
  text-transform: uppercase; /* uppercase */
  margin-bottom: 0.25rem; /* mb-1 */
}

.metric-card-value {
  font-size: 2.25rem; /* text-4xl */
  font-weight: 900; /* font-black */
  color: #1e293b; /* text-slate-800 */
  letter-spacing: -0.015em; /* tracking-tight */
}
</file>

<file path="app/shared/ui/metric-card/metric-card.component.html">
<div class="metric-card bg-white p-6 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300">
  <div>
    <div class="w-10 h-10 rounded-full flex items-center justify-center mb-4" [ngClass]="iconClasses">
      <ng-container *ngTemplateOutlet="iconTemplate; context: { stats: stats }"></ng-container>
    </div>

    <p class="text-[10px] font-black tracking-[0.2em] text-slate-400 uppercase mb-1">{{ title }}</p>

    <h3 class="text-4xl font-black text-slate-800 tracking-tight flex items-baseline">
      {{ value }}
      @if (unit) {
      <span class="text-lg font-medium text-slate-300 ml-1.5">{{ unit }}</span>
      }
    </h3>

    @if (trend !== 0) {
    <div class="flex items-center mt-3">
      <span [class]="trend > 0 ? 'text-emerald-600 bg-emerald-50 border-emerald-100/50' : 'text-rose-600 bg-rose-50 border-rose-100/50'"
            class="flex items-center text-[11px] font-black px-2 py-1 rounded-lg border shadow-sm transition-transform hover:scale-105">

        <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          @if (trend > 0) {
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 15l7-7 7 7"/>
    } @else {
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"/>
    }
    </svg>

    {{ trend > 0 ? trend : (trend * -1) }}%
        </span>
        <span class="text-[10px] text-slate-400 ml-2 font-bold whitespace-nowrap italic opacity-70">vs last month</span>
      </div>
    }
  </div>

  <div class="mt-6 pt-4 border-t border-slate-50">
    <ng-container *ngTemplateOutlet="footerTemplate; context: { stats: stats }"></ng-container>
  </div>
</div>
</file>

<file path="app/shared/ui/metric-card/metric-card.component.ts">
import { Component, Input, TemplateRef } from '@angular/core';
import { CommonModule } from '@angular/common';

@Component({
  selector: 'app-metric-card',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './metric-card.component.html',
  styleUrl: './metric-card.component.css'
})
export class MetricCardComponent {
  @Input() title: string = '';
  @Input() value: string | null = '';
  @Input() unit?: string;
  @Input() iconClasses: string = '';
  @Input() iconTemplate?: TemplateRef<any>;
  @Input() footerTemplate?: TemplateRef<any>;
  @Input() stats: any;
  @Input() trend: number = 0;
}
</file>

