              <div class="flex justify-between items-center">
                <span class="text-xs font-medium text-slate-600">Daily Weights</span>
                <button
                  (click)="navigateToEntity('weights')"
                  class="flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 hover:bg-slate-200 rounded-lg text-[11px] font-bold text-slate-700 transition-colors"
                >
                  <lucide-icon name="trending-up" class="w-3.5 h-3.5"></lucide-icon>
                  Trend
                </button>
              </div>
              <div class="flex justify-between items-center">
