<div class="flex w-full flex-col gap-6 bg-slate-50 p-6">
  <div [class.pointer-events-none]="isUserFormOpen() || isDrawerOpen()" class="flex flex-col gap-6">
    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="text-[11px] font-black uppercase tracking-[0.16em] text-slate-400">
            Admin / Coaching
          </p>
          <h1 class="mt-1 text-2xl font-black tracking-tight text-slate-900">Users Directory</h1>
          <p class="mt-1 text-sm text-slate-500">
            Search, review, and take action on account records
          </p>
        </div>

        <button
          type="button"
          (click)="openQuickAddUser()"
          class="quick-add-btn inline-flex shrink-0 items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-xs font-bold text-white"
        >
          <lucide-icon name="user-plus" class="h-4 w-4"></lucide-icon>
          Quick Add User
        </button>
      </div>

      <div class="mt-4 grid h-fit grid-cols-1 gap-4 md:grid-cols-4">
        @for (card of cards; track card.label) {
          <app-kpi-card
            themeColor="indigo"
            [label]="card.label"
            [value]="card.val"
            [trend]="card.trend"
            [context]="card.context"
            [mainIcon]="card.icon"
            [showInfoIcon]="true"
            [infoText]="card.info"
          >
          </app-kpi-card>
        }
      </div>

      @if (selectedUsers().length > 0) {
        <div
          class="mt-4 flex items-center justify-between rounded-[16px] border border-slate-200 bg-white p-4 shadow-sm animate-in transition-all"
        >
          <div>
            <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-0.5">
              Selection
            </p>
            <p class="text-sm font-bold text-slate-800">
              {{ selectedUsers().length }} account selected
            </p>
          </div>
          <div class="flex gap-2">
            <button
              class="px-5 py-2.5 bg-black text-white text-[11px] font-bold rounded-xl hover:bg-slate-800 transition-all"
            >
              Suspend
            </button>
            <button
              class="px-5 py-2.5 bg-slate-100 text-slate-700 text-[11px] font-bold rounded-xl hover:bg-slate-200 transition-all"
            >
              Reset Password
            </button>
            <button
              class="px-5 py-2.5 bg-slate-100 text-slate-700 text-[11px] font-bold rounded-xl hover:bg-slate-200 transition-all"
            >
              Assign Role
            </button>
          </div>
        </div>
      }
    </section>

    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-3">
        <div>
          <p class="text-[11px] font-black uppercase tracking-[0.14em] text-indigo-600">
            User Registry
          </p>
          <h2 class="mt-0.5 text-sm font-black uppercase tracking-[0.12em] text-slate-700">
            Active Accounts
          </h2>
        </div>
        <span
          class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-600"
          >{{ filteredUsers().length }} users</span
        >
      </div>
      <div class="p-4 grid-shell">
        <app-grid
          [resizableRows]="true"
          class="h-full w-full"
          [columns]="userColumns"
          [data]="filteredUsers()"
          [isLoading]="isLoading()"
          [searchTerm]="searchTerm()"
          [showExport]="true"
          [showFilters]="true"
          [showSearch]="true"
          (search)="onSearch($event)"
          (refresh)="loadData()"
          (actionTriggered)="handleGridAction($event)"
          (selectionChanged)="selectedUsers.set($event)"
          [reorderable]="true"
        >
        </app-grid>
      </div>
    </div>
  </div>

  @if (isDrawerOpen() || isUserFormOpen()) {
    <div
      (click)="closeOverlays()"
      class="fixed inset-0 z-40 bg-slate-900/5 backdrop-blur-[2px] transition-opacity"
    ></div>
  }

  @if (isUserFormOpen()) {
    <section
      class="fixed right-0 top-0 z-[100] h-full w-full max-w-[440px] border-l border-slate-200 bg-gradient-to-b from-white to-slate-50 p-6 shadow-2xl"
    >
      <div class="flex h-full flex-col">
        <div class="mb-5 flex items-center justify-between">
          <div>
            <p class="text-[11px] font-black uppercase tracking-[0.14em] text-slate-400">
              User Directory
            </p>
            <h2 class="text-xl font-black text-slate-900">
              {{ editingUserId() ? 'Edit User' : 'New User' }}
            </h2>
          </div>
          <button
            type="button"
            class="rounded-lg p-2 text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-800"
            (click)="closeUserForm()"
            aria-label="Close user form"
          >
            <lucide-icon name="x" class="h-4 w-4"></lucide-icon>
          </button>
        </div>

        <form class="flex min-h-0 flex-1 flex-col" (ngSubmit)="submitUserForm()">
          <div class="form-scroll-area flex-1 min-h-0 space-y-4 overflow-y-auto pr-1">
            <label class="block space-y-1">
              <span class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500"
                >Full Name</span
              >
              <input
                [ngModel]="userForm().fullName"
                (ngModelChange)="updateUserFormField('fullName', $event)"
                name="fullName"
                required
                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"
                placeholder="Alex Morgan"
              />
            </label>

            <label class="block space-y-1">
              <span class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500"
                >Email</span
              >
              <input
                type="email"
                [ngModel]="userForm().email"
                (ngModelChange)="updateUserFormField('email', $event)"
                name="email"
                required
                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"
                placeholder="alex@ironlogic.ai"
              />
            </label>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <label class="block space-y-1">
                <span class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500"
                  >Tier</span
                >
                <select
                  [ngModel]="userForm().tier"
                  (ngModelChange)="updateUserFormField('tier', $event)"
                  name="tier"
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"
                >
                  <option value="Basic">Basic</option>
                  <option value="Pro">Pro</option>
                  <option value="Elite">Elite</option>
                </select>
              </label>

              <label class="block space-y-1">
                <span class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500"
                  >Initial Status</span
                >
                <select
                  [ngModel]="userForm().status"
                  (ngModelChange)="updateUserFormField('status', $event)"
                  name="status"
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"
                >
                  <option value="Active">Active</option>
                  <option value="Review">Review</option>
                </select>
              </label>
            </div>
          </div>

          <div class="mt-6 flex items-center justify-end gap-2 border-t border-slate-100 pt-4">
            <button
              type="button"
              (click)="closeUserForm()"
              class="rounded-xl border border-violet-200 bg-violet-50 px-4 py-2 text-xs font-bold text-violet-700 transition-colors hover:bg-violet-100"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="quick-add-btn rounded-xl px-4 py-2 text-xs font-bold text-white"
            >
              {{ editingUserId() ? 'Update User' : 'Save User' }}
            </button>
          </div>
        </form>
      </div>
    </section>
  }

  @if (isDrawerOpen() && activeUserDetails()) {
    <div class="fixed top-0 right-0 h-full w-full max-w-[420px] z-50 animate-in-drawer p-4">
      <div
        class="h-full bg-slate-50/95 backdrop-blur-2xl rounded-[2.5rem] border border-white shadow-2xl p-8 overflow-y-auto flex flex-col"
      >
        <div class="flex justify-between items-start mb-8 shrink-0">
          <div class="flex items-center gap-4">
            <div
              class="w-16 h-16 rounded-full overflow-hidden bg-slate-100 border border-slate-200 shrink-0 flex items-center justify-center"
            >
              <img
                *ngIf="activeUserDetails()?.profileImageUrl"
                [src]="activeUserDetails()?.profileImageUrl"
                alt=""
                class="w-full h-full object-cover"
              />
              <span
                *ngIf="!activeUserDetails()?.profileImageUrl"
                class="text-[20px] font-black text-slate-600"
                >{{ (activeUserDetails()?.name || '?')[0] | uppercase }}</span
              >
            </div>
            <div>
              <h2 class="text-2xl font-black text-slate-900 tracking-tight">
                {{ activeUserDetails()?.name }}
              </h2>
              <p class="text-xs font-medium text-slate-500 mt-1">
                {{ activeUserDetails()?.tier }} account overview and recent linked activity
              </p>
            </div>
          </div>
          <button
            (click)="closeDrawer()"
            class="p-2 hover:bg-slate-200/50 rounded-xl transition-all font-bold text-slate-600"
          >
            ✕
          </button>
        </div>

        <div class="space-y-4 flex-1 pb-10">
          <div class="p-5 bg-white rounded-2xl shadow-sm border border-slate-100/50">
            <h3 class="text-sm font-black text-slate-900 mb-3.5">Grid Row Data</h3>
            <div class="space-y-3 text-xs font-medium text-slate-600">
              <div class="flex justify-between items-center">
                <span class="text-slate-400">ID</span>
                <span class="font-bold text-slate-800">{{ activeUserDetails()?.id || '-' }}</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-slate-400">Name</span>
                <span class="font-bold text-slate-800">{{ activeUserDetails()?.name || '-' }}</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-slate-400">Status</span>
                <span class="font-bold text-slate-800">{{
                  activeUserDetails()?.status || '-'
                }}</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-slate-400">Tier</span>
