      amount: 160,
      date: '2026-04-04',
      status: 'Paid',
    },
    {
      id: 5,
      athleteName: 'Arman Fathi',
      planType: 'Gold',
      amount: 220,
      date: '2026-04-03',
      status: 'Paid',
    },
    {
      id: 6,
      athleteName: 'Babak Sharifi',
      planType: 'Silver',
      amount: 160,
      date: '2026-04-02',
      status: 'Pending',
    },
    {
      id: 7,
      athleteName: 'Dariush Kazemi',
      planType: 'Gold',
      amount: 220,
      date: '2026-03-31',
      status: 'Paid',
    },
    {
      id: 8,
      athleteName: 'Parisa Vahidi',
      planType: 'Silver',
      amount: 160,
      date: '2026-03-30',
      status: 'Paid',
    },
    {
      id: 9,
      athleteName: 'Matin Amini',
      planType: 'Gold',
      amount: 220,
      date: '2026-03-29',
      status: 'Pending',
    },
    {
      id: 10,
      athleteName: 'Mehrdad Nouri',
      planType: 'Silver',
      amount: 160,
      date: '2026-03-28',
      status: 'Paid',
    },
  ];

  readonly financialSettings = computed(() => this.configService.financialSettings());

  readonly transactionColumns = computed<ColumnConfig[]>(() => {
    const currencyCode = this.financialSettings().baseCurrency;
    return [
      {
        field: 'athleteName',
        title: 'ATHLETE NAME',
        type: 'text',
        width: '240px',
        sortable: true,
        locked: true,
        filterType: 'text',
      },
      {
        field: 'planType',
        title: 'PLAN TYPE',
        type: 'badge',
        width: '140px',
