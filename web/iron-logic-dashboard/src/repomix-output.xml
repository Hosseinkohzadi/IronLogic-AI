                      </div>
                      <span class="font-semibold text-slate-800">{{ item.name }}</span>
                    </div>
                  </td>
                  <td class="px-4 py-3 text-slate-500">{{ item.plan }}</td>
                  <td class="px-4 py-3 text-center">
                    <span
                      class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold"
                      [class.bg-rose-100]="item.daysLeft <= 2"
                      [class.text-rose-700]="item.daysLeft <= 2"
                      [class.bg-amber-100]="item.daysLeft > 2 && item.daysLeft <= 5"
                      [class.text-amber-700]="item.daysLeft > 2 && item.daysLeft <= 5"
                      [class.bg-slate-100]="item.daysLeft > 5"
                      [class.text-slate-600]="item.daysLeft > 5"
                      >{{ item.daysLeft }}d</span
                    >
                  </td>
                  <td class="px-4 py-3 text-right font-black text-violet-700">
                    ${{ item.amount }}
                  </td>
                </tr>
              }
            </tbody>
            <tfoot>
              <tr class="bg-violet-50">
                <td
                  colspan="3"
                  class="px-4 py-2.5 text-right text-xs font-black uppercase tracking-[0.10em] text-violet-600"
                >
                  Total at Risk
                </td>
                <td class="px-4 py-2.5 text-right text-sm font-black text-violet-700">
                  {{ revenueDetail.pending }}
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>
  </aside>
}
</file>

