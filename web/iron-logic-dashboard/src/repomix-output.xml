              <span class="inline-block bg-indigo-50 text-indigo-700 text-[10px] font-black px-2 py-1 rounded">BEST: {{ getBestSet(ex.sets) }}</span>
              }
              <svg class="w-4 h-4 text-slate-400 transition-transform duration-300" [class.rotate-180]="isExpanded(ex.exerciseName)" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
