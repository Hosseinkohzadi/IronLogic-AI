                <thead class="text-[10px] text-slate-400 uppercase bg-slate-100 rounded-lg">
                  <tr><th class="px-2 py-1.5 rounded-l-lg">Set</th><th class="px-2 py-1.5">Weight</th><th class="px-2 py-1.5">Reps</th><th class="px-2 py-1.5 rounded-r-lg">RPE</th></tr>
                </thead>
                <tbody>
                  @for (set of ex.sets; track set.setIndex) {
                  <tr class="border-b border-slate-100 last:border-0" [class.bg-amber-50]="set.isPr">
                    <td class="px-2 py-2 font-bold text-slate-700">
                      <div class="flex items-center gap-1.5">
                        {{ set.setIndex }}
                        @if (set.isPr) { <svg title="All-Time PR" class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg> }
                      </div>
                    </td>
                    <td class="px-2 py-2 font-medium" [class.text-amber-700]="set.isPr">{{ set.weight }} <span class="text-[10px] text-slate-400">lbs</span></td>
                    <td class="px-2 py-2 font-medium" [class.text-amber-700]="set.isPr">{{ set.reps }}</td>
                    <td class="px-2 py-2">
                      @if (set.rpe) {
                      <span class="px-2 py-0.5 rounded-md font-black text-[10px] border cursor-help" [ngClass]="getRpeColorClass(set.rpe)" [title]="getRpeDescription(set.rpe)">{{ set.rpe }}</span>
                      } @else { <span class="text-slate-300">-</span> }
                    </td>
                  </tr>
                  }
                </tbody>
              </table>
            </div>
          </div>
        </div>
        }
      </div>
    </div>
    }
  </div>
  }
</div>
