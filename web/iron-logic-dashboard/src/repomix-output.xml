          <div class="p-5 bg-white rounded-2xl shadow-sm border border-slate-100/50">
            <h3 class="text-sm font-black text-slate-900 mb-3.5">Audit Trail</h3>
            @for (log of activeUserDetails()?.auditTrail || []; track log) {
