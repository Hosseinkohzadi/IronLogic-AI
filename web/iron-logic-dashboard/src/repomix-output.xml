<file path="app/features/admin/components/exercise-management/exercise-management.html">
<div class="flex h-full min-h-0 flex-col gap-5 overflow-hidden">
  <!-- ── Page Header ──────────────────────────────────────── -->
  <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="text-[11px] font-black uppercase tracking-[0.16em] text-slate-400">Admin / Coaching</p>
        <h1 class="mt-1 text-2xl font-black tracking-tight text-slate-900">Exercise Management</h1>
        <p class="mt-1 text-sm text-slate-500">Manage exercise catalog with AI classification and coaching-ready metadata.</p>
      </div>

      <button
        type="button"
        (click)="openQuickAdd()"
        class="quick-add-btn inline-flex shrink-0 items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-xs font-bold text-white"
      >
        <lucide-icon name="pencil" class="h-4 w-4"></lucide-icon>
        Quick Add Exercise
      </button>
    </div>

    <!-- ── Standalone Filter Bar ───────────────────────── -->
    <div class="mt-4 flex flex-col gap-3 border-t border-slate-100 pt-4 sm:flex-row sm:items-center">
      <!-- Search -->
      <div class="relative flex-1">
        <lucide-icon name="search" class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"></lucide-icon>
        <input
          type="text"
          [ngModel]="searchTerm()"
          (ngModelChange)="onSearch($event)"
          placeholder="Search by name, muscle, equipment..."
          class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2 pl-10 pr-3 text-sm text-slate-700 outline-none focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"
          aria-label="Search exercises"
        />
      </div>

      <!-- Filter by Muscle -->
      <div class="relative sm:w-52">
        <lucide-icon name="filter" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"></lucide-icon>
        <select
          [ngModel]="muscleFilter()"
          (ngModelChange)="onMuscleFilter($event)"
          class="w-full appearance-none rounded-xl border border-slate-200 bg-slate-50 py-2 pl-10 pr-8 text-sm text-slate-700 outline-none focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"
          aria-label="Filter by primary muscle"
        >
          <option value="">All Muscles</option>
          <option value="Chest">Chest</option>
          <option value="Back">Back</option>
          <option value="Legs">Legs</option>
          <option value="Shoulders">Shoulders</option>
          <option value="Core">Core</option>
          <option value="Biceps">Biceps</option>
          <option value="Triceps">Triceps</option>
          <option value="Glutes">Glutes</option>
        </select>
        <lucide-icon name="chevron-down" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"></lucide-icon>
      </div>

      @if (muscleFilter() || searchTerm()) {
        <button
          type="button"
          (click)="onSearch(''); onMuscleFilter('')"
          class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 px-3 py-2 text-xs font-bold text-slate-500 hover:bg-slate-50"
        >
          <lucide-icon name="x" class="h-3.5 w-3.5"></lucide-icon>
          Clear
        </button>
      }
    </div>
  </section>

  <div class="min-h-0 flex-1 overflow-hidden">
    <app-grid
      class="h-full"
      [columns]="exerciseColumns"
      [data]="filteredRows()"
      [isLoading]="isLoading()"
      [searchTerm]="searchTerm()"
      [showExport]="true"
      [showFilters]="true"
      [showSearch]="false"
      [pagerPosition]="'bottom'"
      (refresh)="loadData()"
      (actionTriggered)="handleGridAction($event)"
    ></app-grid>
  </div>

  @if (isQuickAddOpen()) {
    <div class="fixed inset-0 z-40 bg-slate-900/20 backdrop-blur-[2px]" (click)="closeQuickAdd()"></div>

    <section class="fixed right-0 top-0 z-50 h-screen w-full max-w-[440px] border-l border-slate-200 bg-gradient-to-b from-white to-slate-50 p-6 shadow-2xl">
      <div class="flex h-full flex-col">
        <div class="mb-5 flex items-center justify-between">
          <div>
