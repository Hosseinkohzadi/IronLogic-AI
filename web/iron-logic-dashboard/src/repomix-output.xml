                >
                  <lucide-icon name="panel-left" class="w-3.5 h-3.5"></lucide-icon>
                  Inspect
                </button>
              </div>
            </div>
          </div>

          <div class="p-5 bg-white rounded-2xl shadow-sm border border-slate-100/50">
            <h3 class="text-sm font-black text-slate-900 mb-3.5">Account Risk</h3>
            <div class="space-y-2.5 text-xs font-medium text-slate-600">
              <div>
                Support priority:
                <span class="font-bold text-slate-800">{{
                  activeUserDetails()?.supportPriority || '-'
                }}</span>
              </div>
              <div>
                Sync complaints in last 30d:
                <span class="font-bold text-slate-800">{{
                  activeUserDetails()?.syncComplaints || '-'
                }}</span>
              </div>
              <div>
                Billing friction:
                <span class="font-bold text-slate-800">{{
                  activeUserDetails()?.billingFriction || '-'
                }}</span>
              </div>
              <div>
                Retention flag:
                <span class="font-bold text-slate-800">{{
