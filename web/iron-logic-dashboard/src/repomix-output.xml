:host {
  display: block;
  width: 100%;
  overflow-y: auto;
  overflow-x: hidden;
}

.grid-shell {
  display: flex;
  flex-direction: column;
  min-height: 520px;
}

.grid-shell > app-grid,
:host app-grid {
  flex: 1;
  min-height: 0;
  margin: 0 !important;
}

.quick-add-btn {
  background: var(--primary-gradient, linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%));
  box-shadow: 0 10px 24px rgba(79, 70, 229, 0.28);
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.quick-add-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 14px 30px rgba(79, 70, 229, 0.32);
}

.quick-add-btn:focus-visible {
  outline: 2px solid var(--ai-300);
  outline-offset: 2px;
}

.form-scroll-area {
  scrollbar-gutter: stable;
}

.form-scroll-area::-webkit-scrollbar {
  width: 8px;
}

.form-scroll-area::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 9999px;
}

.form-scroll-area::-webkit-scrollbar-track {
  background: transparent;
}

/* استایل Badge ها */
.badge-active {
  display: inline-flex;
  align-items: center;
  border-radius: 0.5rem;
  background: rgba(236, 253, 245, 0.8);
  padding: 0.25rem 0.75rem;
  font-size: 10px;
  font-weight: 900;
  color: #059669;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  box-shadow: inset 0 0 0 1px rgba(16, 185, 129, 0.18);
}

.badge-review {
  display: inline-flex;
  align-items: center;
  border-radius: 0.5rem;
  background: rgba(255, 251, 235, 0.9);
  padding: 0.25rem 0.75rem;
  font-size: 10px;
  font-weight: 900;
  color: #b45309;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  box-shadow: inset 0 0 0 1px rgba(245, 158, 11, 0.24);
}

.badge-suspended {
  display: inline-flex;
  align-items: center;
  border-radius: 0.5rem;
  background: rgba(254, 242, 242, 0.85);
  padding: 0.25rem 0.75rem;
  font-size: 10px;
  font-weight: 900;
  color: #ef4444;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  box-shadow: inset 0 0 0 1px rgba(239, 68, 68, 0.18);
}

/* انیمیشن لود صفحه */
.animate-in {
  animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* انیمیشن ورود دراور از راست */
.animate-in-drawer {
  animation: slideInRight 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(100%);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

/* اسکرول بار */
::-webkit-scrollbar {
  width: 4px;
}

::-webkit-scrollbar-thumb {
  background: #f1f5f9;
  border-radius: 10px;
}

/* Badge Styles for Account Tiers / Plans */
