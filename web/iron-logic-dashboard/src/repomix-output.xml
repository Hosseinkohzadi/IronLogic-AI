              <label class="block space-y-1">
                <span class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Equipment</span>
                <select
                  [ngModel]="quickAddForm().equipment"
                  (ngModelChange)="updateQuickAddField('equipment', $event)"
                  name="equipment"
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"
                >
                  <option value="Barbell">Barbell</option>
                  <option value="Dumbbell">Dumbbell</option>
                  <option value="Cable">Cable</option>
                  <option value="Machine">Machine</option>
                  <option value="Bodyweight">Bodyweight</option>
                </select>
              </label>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <label class="block space-y-1">
                <span class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Mechanics</span>
                <select
                  [ngModel]="quickAddForm().mechanics"
                  (ngModelChange)="updateQuickAddField('mechanics', $event)"
                  name="mechanics"
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"
                >
                  <option value="Compound">Compound</option>
                  <option value="Isolation">Isolation</option>
                </select>
              </label>

              <label class="block space-y-1">
                <span class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Difficulty</span>
                <select
                  [ngModel]="quickAddForm().difficulty"
                  (ngModelChange)="updateQuickAddField('difficulty', $event)"
                  name="difficulty"
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"
                >
                  <option value="Beginner">Beginner</option>
                  <option value="Intermediate">Intermediate</option>
                  <option value="Advanced">Advanced</option>
                </select>
              </label>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <label class="block space-y-1">
                <span class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Logic Tag</span>
                <select
                  [ngModel]="quickAddForm().logicTag"
                  (ngModelChange)="updateQuickAddField('logicTag', $event)"
                  name="logicTag"
                  class="w-full appearance-none rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none focus:border-emerald-300 focus:ring-2 focus:ring-emerald-100"
                >
                  <option value="CNS Intensive">CNS Intensive</option>
                  <option value="Hypertrophy Focus">Hypertrophy Focus</option>
                  <option value="Metabolic Stress">Metabolic Stress</option>
                  <option value="Posterior Chain">Posterior Chain</option>
                </select>
              </label>

              <label class="block space-y-1">
                <span class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Video Link</span>
                <input
                  [ngModel]="quickAddForm().videoLink"
                  (ngModelChange)="updateQuickAddField('videoLink', $event)"
                  name="videoLink"
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"
                  placeholder="https://youtube.com/..."
                />
              </label>
            </div>

            <label class="block space-y-1">
              <span class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Instructions</span>
              <textarea
                [ngModel]="quickAddForm().instructions"
                (ngModelChange)="updateQuickAddField('instructions', $event)"
                name="instructions"
                rows="4"
                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"
                placeholder="Keep chest up, brace core, and control every eccentric rep."
              ></textarea>
            </label>

            <label class="block space-y-1">
              <span class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Demo Image or GIF URL</span>
              <input
                [ngModel]="quickAddForm().demoMediaUrl"
                (ngModelChange)="updateQuickAddField('demoMediaUrl', $event)"
                name="demoMediaUrl"
                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"
                placeholder="https://..."
              />
            </label>

            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
              <p class="text-[11px] font-semibold text-slate-500">Row preview placeholder</p>
              <div class="mt-2 flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-400">
                  <lucide-icon name="eye" class="h-4 w-4"></lucide-icon>
                </div>
                <p class="text-xs text-slate-500">A thumbnail slot will appear in the grid even if no media URL is provided.</p>
              </div>
            </div>
          </div>

          <div class="mt-6 flex items-center justify-end gap-2 border-t border-slate-100 pt-4">
            <button
              type="button"
              (click)="closeQuickAdd()"
              class="rounded-xl border border-violet-200 bg-violet-50 px-4 py-2 text-xs font-bold text-violet-700 transition-colors hover:bg-violet-100"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="quick-add-btn rounded-xl px-4 py-2 text-xs font-bold text-white"
            >
              Save Exercise
            </button>
          </div>
        </form>
      </div>
    </section>
  }
</div>
