        videoLink: 'https://www.youtube.com/watch?v=op9kVnSso6Q'
      },
      {
        id: 'mock-4',
        demoMediaUrl: 'https://images.unsplash.com/photo-1599058917212-d750089bc07e?auto=format&fit=crop&w=320&q=80',
        name: 'Pull-Ups',
