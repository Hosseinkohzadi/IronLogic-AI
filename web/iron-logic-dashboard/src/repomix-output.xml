import { ChangeDetectionStrategy, Component, OnDestroy, computed, inject, signal } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { Router } from '@angular/router';
import { AuthService } from '@core/services/auth.service';

interface WorkoutSetEntry {
  id: number;
  previous: string;
  target: string;
  actualKg: string;
  actualReps: string;
  done: boolean;
}

interface WorkoutExerciseEntry {
  id: number;
  name: string;
  coachNotes: string;
  oneRmHistory: string[];
  sets: WorkoutSetEntry[];
}

interface RoutinePreviewItem {
  name: string;
  suggestion: string;
}

interface CoachCornerData {
  coachName: string;
  message: string;
}

interface CalendarDay {
  day: number;
  completed: boolean;
}

interface AthletePortalData {
  id: string;
  athleteName: string;
  activeRoutineTitle: string;
  lineChartValues: number[];
  routinePreview: RoutinePreviewItem[];
  coachCorner: CoachCornerData;
  muscleHeatmap: Array<{ muscle: string; intensity: number }>;
  calendarDays: CalendarDay[];
  workoutExercises: WorkoutExerciseEntry[];
}

@Component({
  selector: 'app-athlete-portal',
  imports: [CommonModule, FormsModule],
  templateUrl: './athlete-portal.html',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class AthletePortalComponent implements OnDestroy {
  private readonly router = inject(Router);
  private readonly authService = inject(AuthService);

  private elapsedIntervalId: ReturnType<typeof setInterval> | null = null;
  private restIntervalId: ReturnType<typeof setInterval> | null = null;

  readonly isWorkingOut = signal(false);
  readonly elapsedSeconds = signal(0);
  readonly restRemainingSeconds = signal(0);
  readonly selectedExerciseId = signal<number | null>(null);

  private readonly athletePortalDataById: Record<string, AthletePortalData> = {
    'athlete-hossein-001': {
      id: 'athlete-hossein-001',
      athleteName: 'Hossein',
      activeRoutineTitle: 'Today: Leg Day Hypertrophy',
      lineChartValues: [62, 64, 67, 66, 70, 73, 76],
      routinePreview: [
        { name: 'Barbell Squat', suggestion: '+2.5kg progression approved' },
        { name: 'Romanian Deadlift', suggestion: '+1 rep on final set' },
        { name: 'Leg Press', suggestion: 'Tempo: 3-1-1 for control' },
      ],
      coachCorner: {
        coachName: 'Coach Arman',
        message:
          'Prioritize depth consistency on squats today. Keep bracing tight and send one side-view set for form feedback.',
      },
      muscleHeatmap: [
        { muscle: 'Quads', intensity: 92 },
        { muscle: 'Hamstrings', intensity: 84 },
        { muscle: 'Glutes', intensity: 88 },
        { muscle: 'Core', intensity: 64 },
        { muscle: 'Calves', intensity: 58 },
      ],
      calendarDays: [
        { day: 1, completed: true },
        { day: 2, completed: false },
        { day: 3, completed: true },
        { day: 4, completed: true },
        { day: 5, completed: false },
        { day: 6, completed: true },
        { day: 7, completed: false },
        { day: 8, completed: true },
        { day: 9, completed: true },
        { day: 10, completed: false },
        { day: 11, completed: true },
        { day: 12, completed: true },
        { day: 13, completed: false },
        { day: 14, completed: true },
        { day: 15, completed: false },
        { day: 16, completed: true },
        { day: 17, completed: true },
        { day: 18, completed: false },
        { day: 19, completed: true },
        { day: 20, completed: true },
        { day: 21, completed: false },
        { day: 22, completed: true },
        { day: 23, completed: false },
        { day: 24, completed: true },
        { day: 25, completed: true },
        { day: 26, completed: false },
        { day: 27, completed: true },
        { day: 28, completed: true },
      ],
      workoutExercises: [
        {
          id: 1,
          name: 'Barbell Squat',
          coachNotes:
            'Drive knees over toes on the way down and keep ribcage stacked on the ascent. Last set should stay at RPE 8.',
          oneRmHistory: ['145kg', '147.5kg', '150kg'],
          sets: [
            { id: 1, previous: '100 x 8', target: '105 x 8', actualKg: '', actualReps: '', done: false },
            { id: 2, previous: '105 x 8', target: '107.5 x 8', actualKg: '', actualReps: '', done: false },
            { id: 3, previous: '107.5 x 7', target: '110 x 7', actualKg: '', actualReps: '', done: false },
          ],
        },
        {
          id: 2,
          name: 'Romanian Deadlift',
          coachNotes:
            'Maintain soft knees and long hamstring tension. Pause 1 second below knees before ascending.',
          oneRmHistory: ['170kg', '175kg', '177.5kg'],
          sets: [
            { id: 1, previous: '80 x 10', target: '82.5 x 10', actualKg: '', actualReps: '', done: false },
            { id: 2, previous: '82.5 x 9', target: '85 x 9', actualKg: '', actualReps: '', done: false },
          ],
        },
      ],
    },
  };

  readonly currentAthleteData = computed(() => {
    const currentUserId = this.authService.currentUserId();
    if (!currentUserId) {
      return null;
    }

    return this.athletePortalDataById[currentUserId] ?? null;
  });

  readonly workoutExercises = signal<WorkoutExerciseEntry[]>(this.buildInitialExercises());

  readonly selectedExercise = computed(() => {
    const exerciseId = this.selectedExerciseId();
    if (exerciseId === null) {
      return null;
    }

    return this.workoutExercises().find((exercise) => exercise.id === exerciseId) ?? null;
  });

  readonly lineChartPoints = computed(() => {
    const values = this.currentAthleteData()?.lineChartValues ?? [];
    if (values.length === 0) {
      return '';
    }

    const width = 560;
    const height = 220;
    const min = Math.min(...values);
    const max = Math.max(...values);
    const range = Math.max(max - min, 1);

    return values
      .map((value, index) => {
        const x = (index / Math.max(values.length - 1, 1)) * width;
        const y = height - ((value - min) / range) * height;
        return `${x},${y}`;
      })
      .join(' ');
  });

  startWorkout(): void {
    this.isWorkingOut.set(true);
    this.elapsedSeconds.set(0);
    this.startElapsedTimer();
  }

  stopWorkout(): void {
    this.isWorkingOut.set(false);
    this.stopElapsedTimer();
    this.stopRestTimer();
    this.restRemainingSeconds.set(0);
  }

  updateActualKg(exerciseId: number, setId: number, value: string): void {
    this.updateSet(exerciseId, setId, (set) => ({ ...set, actualKg: value }));
  }

  updateActualReps(exerciseId: number, setId: number, value: string): void {
    this.updateSet(exerciseId, setId, (set) => ({ ...set, actualReps: value }));
  }

  markSetDone(exerciseId: number, setId: number): void {
    this.updateSet(exerciseId, setId, (set) => ({ ...set, done: true }));
    this.startRestTimer(90);
  }

  openExerciseInsights(exerciseId: number): void {
    this.selectedExerciseId.set(exerciseId);
  }

  closeExerciseInsights(): void {
    this.selectedExerciseId.set(null);
  }

  formatSeconds(totalSeconds: number): string {
    const safeSeconds = Math.max(totalSeconds, 0);
    const minutes = Math.floor(safeSeconds / 60)
      .toString()
      .padStart(2, '0');
    const seconds = (safeSeconds % 60).toString().padStart(2, '0');
    return `${minutes}:${seconds}`;
  }

  isSetDone(exerciseId: number, setId: number): boolean {
    const exercise = this.workoutExercises().find((item) => item.id === exerciseId);
    const set = exercise?.sets.find((item) => item.id === setId);
    return !!set?.done;
  }

  hasAccessToAthletePortal(): boolean {
    if (this.authService.hasRole('ATHLETE') && this.currentAthleteData()) {
      return true;
    }

    return false;
  }

  goToLogin(): void {
    this.router.navigate(['/login']);
  }

  ngOnDestroy(): void {
    this.stopElapsedTimer();
    this.stopRestTimer();
  }

  private buildInitialExercises(): WorkoutExerciseEntry[] {
    const currentUserId = this.authService.currentUserId();
    if (!currentUserId || !this.athletePortalDataById[currentUserId]) {
      return [];
    }

    return this.athletePortalDataById[currentUserId].workoutExercises.map((exercise) => ({
      ...exercise,
      sets: exercise.sets.map((set) => ({ ...set })),
    }));
  }

  private startElapsedTimer(): void {
    this.stopElapsedTimer();
    this.elapsedIntervalId = setInterval(() => {
      this.elapsedSeconds.update((value) => value + 1);
    }, 1000);
  }

  private stopElapsedTimer(): void {
    if (this.elapsedIntervalId) {
      clearInterval(this.elapsedIntervalId);
      this.elapsedIntervalId = null;
    }
  }

  private startRestTimer(durationSeconds: number): void {
    this.stopRestTimer();
    this.restRemainingSeconds.set(durationSeconds);

    this.restIntervalId = setInterval(() => {
      const remaining = this.restRemainingSeconds();
      if (remaining <= 1) {
        this.restRemainingSeconds.set(0);
        this.stopRestTimer();
        return;
      }

      this.restRemainingSeconds.set(remaining - 1);
    }, 1000);
  }

  private stopRestTimer(): void {
    if (this.restIntervalId) {
      clearInterval(this.restIntervalId);
      this.restIntervalId = null;
    }
  }

  private updateSet(
    exerciseId: number,
    setId: number,
    updater: (set: WorkoutSetEntry) => WorkoutSetEntry,
  ): void {
    this.workoutExercises.update((exercises) =>
      exercises.map((exercise) => {
        if (exercise.id !== exerciseId) {
          return exercise;
        }

        return {
          ...exercise,
          sets: exercise.sets.map((set) => (set.id === setId ? updater(set) : set)),
        };
      }),
    );
  }
}
