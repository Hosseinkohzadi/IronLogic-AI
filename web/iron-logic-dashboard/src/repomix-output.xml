      <div class="flex h-full flex-col overflow-y-auto rounded-[2.5rem] border border-white bg-slate-50/95 p-8 shadow-2xl backdrop-blur-2xl">
        <div class="mb-8 shrink-0">
          <div class="flex items-start justify-between">
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 rounded-[14px] overflow-hidden bg-white border border-slate-200 shrink-0 flex items-center justify-center shadow-sm p-1">
                <img *ngIf="selectedEquipment()?.imageUrl"
                     [src]="selectedEquipment()?.imageUrl"
                     alt=""
                     class="w-full h-full object-cover rounded-[10px]">
                <svg *ngIf="!selectedEquipment()?.imageUrl" class="w-6 h-6 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <path d="M21 15l-5-5L5 21"></path>
                </svg>
              </div>
              <div>
                <h2 class="text-2xl font-black tracking-tight text-slate-900">{{ selectedEquipment()?.name }}</h2>
                <p class="mt-1 text-xs font-medium text-slate-500">{{ selectedEquipment()?.description }}</p>
              </div>
            </div>
            <button
              type="button"
              aria-label="Close panel"
              class="rounded-xl p-2 font-bold text-slate-600 transition-all hover:bg-slate-200/50"
              (click)="closeDrawer()">
              x
            </button>
          </div>

          <div class="mt-4 flex items-center gap-2">
            <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-emerald-700">{{ selectedEquipment()?.status }}</span>
            <span class="rounded-full border border-slate-200 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-slate-600">{{ selectedEquipment()?.health === 'Healthy' ? 'Healthy' : 'Needs Attention' }}</span>
          </div>
        </div>

        <div class="space-y-4 pb-10">
          <div class="rounded-2xl border border-slate-100/50 bg-slate-50 p-5">
            <h3 class="mb-3.5 text-sm font-black text-slate-900">Reference Summary</h3>
            <div class="space-y-3 text-xs font-medium text-slate-600">
              <div class="flex items-center justify-between">
                <span class="text-slate-400">Linked exercises</span>
                <span class="font-bold text-slate-800">{{ selectedEquipment()?.linkedExercises }}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-400">Alias conflicts</span>
                <span class="font-bold text-slate-800">{{ selectedEquipment()?.aliasConflicts }}</span>
              </div>
              <div class="flex items-center justify-between border-t border-slate-100 pt-2">
                <span class="text-slate-400">Last review</span>
                <span class="font-bold text-slate-800">{{ selectedEquipment()?.lastReview }}</span>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-slate-100/50 bg-white p-5 shadow-sm">
            <h3 class="mb-3.5 text-sm font-black text-slate-900">Linked Entities</h3>
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-600">Sessions</span>
                <button
                  type="button"
                  class="flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 hover:bg-slate-200 rounded-lg text-[11px] font-bold text-slate-700"
                  (click)="navigateLinkedEntity('sessions')">
                  <lucide-icon name="eye" class="h-3.5 w-3.5"></lucide-icon>
                  View
                </button>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-600">Daily Weights</span>
                <button
                  type="button"
                  class="flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 hover:bg-slate-200 rounded-lg text-[11px] font-bold text-slate-700"
                  (click)="navigateLinkedEntity('weights')">
                  <lucide-icon name="trending-up" class="h-3.5 w-3.5"></lucide-icon>
                  Trend
                </button>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-600">Exercise Sessions</span>
                <button
                  type="button"
                  class="flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 hover:bg-slate-200 rounded-lg text-[11px] font-bold text-slate-700"
                  (click)="navigateLinkedEntity('exerciseSessions')">
                  <lucide-icon name="panel-left" class="h-3.5 w-3.5"></lucide-icon>
                  Inspect
                </button>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-slate-100/50 bg-slate-50 p-5">
            <h3 class="mb-3.5 text-sm font-black text-slate-900">Actions</h3>
            <div class="flex flex-wrap gap-2.5">
              <button
                type="button"
                class="bg-black text-white rounded-lg px-4 py-2 font-bold text-[11px]"
                (click)="selectedEquipment() && handleEdit(selectedEquipment()!)">
                Edit
              </button>
              <button
                type="button"
                class="bg-slate-200 text-slate-700 rounded-lg px-4 py-2 font-bold text-[11px]"
                (click)="handleMerge(selectedEquipmentId())">
                Merge
              </button>
              <button
                type="button"
                class="bg-slate-200 text-slate-700 rounded-lg px-4 py-2 font-bold text-[11px]"
                (click)="handleDelete(selectedEquipmentId())">
                Delete
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  }
</div>

<div *ngIf="isAddModalOpen()" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm">
